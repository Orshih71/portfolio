---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import LogoTile from '../components/LogoTile.astro';
import bay from '../assets/bat-bay.jpg';
import { profile, impact, work, experience, education } from '../data/profile';

const description = `${profile.name}, ${profile.title.toLowerCase()} in ${profile.location}. ${profile.tagline}`;
---

<Base title={`${profile.name} · ${profile.title}`} description={description}>
  <div class="page">
    <Sidebar />

    <main id="content">
      <ul class="impact" aria-label="Impact at a glance">
        {
          impact.map((item) => (
            <li>
              <span class="impact-value mono">{item.value}</span>
              <span class="impact-label">{item.label}</span>
            </li>
          ))
        }
      </ul>

      <section id="projects" aria-labelledby="projects-heading">
        <h2 id="projects-heading" class="section-label">Key projects</h2>
        <ol class="work">
          {
            work.map((w) => (
              <li class="card">
                <h3 class="card-title">{w.title}</h3>
                <dl class="card-body">
                  <dt>Problem</dt>
                  <dd>{w.problem}</dd>
                  <dt>What I built</dt>
                  <dd>{w.built}</dd>
                  <dt>Result</dt>
                  <dd class="result">{w.result}</dd>
                </dl>
                <ul class="tags" aria-label="Technologies">
                  {w.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="experience" aria-labelledby="experience-heading">
        <h2 id="experience-heading" class="section-label">Experience</h2>
        <ol class="companies">
          {
            experience.map((c) => (
              <li class="company">
                <LogoTile logo={c.logo} />
                <div class="company-body">
                  <h3 class="company-name">{c.company}</h3>
                  <p class="company-meta">
                    {c.place} <span aria-hidden="true">·</span> <span class="mono">{c.dates}</span>
                  </p>
                  <ol class={c.roles.length > 1 ? 'roles timeline' : 'roles'}>
                    {c.roles.map((r) => (
                      <li class="role">
                        <div class="role-head">
                          <h4 class="role-title">{r.title}</h4>
                          {c.roles.length > 1 && <span class="role-dates mono">{r.dates}</span>}
                        </div>
                        <p class="role-summary">{r.summary}</p>
                        <ul class="tags" aria-label="Technologies">
                          {r.tags.map((t) => (
                            <li>{t}</li>
                          ))}
                        </ul>
                      </li>
                    ))}
                  </ol>
                </div>
              </li>
            ))
          }
        </ol>

        <h3 class="subhead">Education</h3>
        <ul class="education">
          {
            education.map((e) => (
              <li>
                <LogoTile logo={e.logo} />
                <div class="edu-body">
                  <p class="edu-degree">{e.degree}</p>
                  <p class="company-meta">
                    {e.school} <span aria-hidden="true">·</span> <span class="mono">{e.dates}</span>
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="about" aria-labelledby="about-heading">
        <h2 id="about-heading" class="section-label">About</h2>
        <figure class="photo">
          <Image
            src={bay}
            alt={`${profile.shortName} on the San Francisco Bay at dusk, with the city skyline behind`}
            widths={[640, 960, 1400]}
            sizes="(min-width: 1024px) 640px, 100vw"
          />
        </figure>
        <div class="prose">
          <p>
            I'm {profile.shortName}. I started my career in Ulaanbaatar, Mongolia, building web apps
            and ERP systems at Asterisk Technologies while finishing a software engineering degree at
            the National University of Mongolia. I then built banking and credit-scoring software at
            Trade and Development Bank.
          </p>
          <p>
            In 2019 I moved to Fairfield, Iowa, for a master's in computer science, and in 2020 I
            joined eBay. Over six years there I grew from Software Engineer 2 to Member of Technical
            Staff, working on the backend for category, search-landing and product pages.
          </p>
          <p>
            The work I like most is where scale meets the shopper, like a latency budget, an A/B
            test, or a migration that has to land without anyone noticing. Lately that includes building AI
            agents into how code gets shipped.
          </p>
        </div>
      </section>

    </main>
  </div>
</Base>

<style>
  .page {
    max-width: var(--content);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  @media (min-width: 1024px) {
    .page {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
      padding: 0 3rem;
    }

    main {
      padding: 5rem 0;
    }
  }

  section {
    padding-top: 4.5rem;
    scroll-margin-top: 2rem;
  }

  .section-label {
    margin-bottom: 1.75rem;
    color: var(--muted);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Impact strip */
  .impact {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .impact {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .impact li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
    background: var(--card);
    border-radius: var(--radius);
  }

  .impact-value {
    color: var(--warm);
    font-size: 1.4rem;
    line-height: 1.1;
  }

  .impact-label {
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.35;
  }

  /* Work cards */
  .work {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: background 0.2s ease;
  }

  .card:hover {
    background: var(--card);
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.15;
  }

  .card-body {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 0.5rem 1rem;
    margin: 1rem 0 0;
    font-size: 0.95rem;
  }

  .card-body dt {
    color: var(--muted);
    font-size: 0.8rem;
    padding-top: 0.15rem;
  }

  .card-body dd {
    margin: 0;
  }

  .card-body .result {
    color: var(--warm);
    font-weight: 500;
  }

  @media (max-width: 520px) {
    .card-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }

    .card-body dd {
      margin-bottom: 0.6rem;
    }
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .tags li {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    background: var(--card);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .card:hover .tags li {
    background: var(--bg);
  }

  /* Experience: one block per company, roles listed beneath it */
  .companies,
  .roles {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .companies {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .company,
  .education li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 1rem;
  }

  .company-name {
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .company-meta {
    color: var(--muted);
    font-size: 0.85rem;
  }

  .company-meta .mono {
    font-size: 0.8rem;
  }

  .roles {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1rem;
  }

  /* Several roles at one company read as a progression, joined by a line. */
  .roles.timeline .role {
    position: relative;
    padding-left: 1.25rem;
  }

  .roles.timeline .role::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    transform: translateX(-3px);
  }

  .roles.timeline .role:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 0;
    top: 1.15rem;
    bottom: -1.5rem;
    width: 1px;
    background: color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .role-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.1rem 1rem;
  }

  .role-title {
    font-size: 1rem;
    font-weight: 500;
  }

  .role-dates {
    color: var(--muted);
    font-size: 0.8rem;
  }

  .role-summary {
    margin-top: 0.35rem;
    font-size: 0.95rem;
  }

  .subhead {
    margin: 3.5rem 0 1.25rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.6rem;
  }

  .education {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .education li {
    align-items: center;
  }

  .edu-degree {
    font-weight: 500;
  }

  /* About */
  .photo {
    margin: 0 0 1.75rem;
  }

  .photo img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 1.05rem;
  }

  /* Breathing room after the last section, now that there's no footer. */
  main {
    padding-bottom: 5rem;
  }
</style>
